{
  "name": "retro-netplay",
  "version": "2.0.0",
  "private": true,
  "description": "Play older games online with friends and strangers, arcade style",
  "author": "Retro-Netplay contributors",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "net.netplay.retro",
    "productName": "Retro-Netplay",
    "asar": true,
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "../dist-engine/Retro-Netplay-Engine", "to": "engine" }],
    "protocols": [{ "name": "Retro-Netplay link", "schemes": ["netplay"] }],
    "linux": { "target": ["AppImage", "zip"], "category": "Game", "icon": "../icon-256.png", "artifactName": "Retro-Netplay-${arch}.${ext}" },
    "win": { "target": ["zip"], "icon": "../icon-256.png", "artifactName": "Retro-Netplay-windows-${arch}.${ext}" }
  }
}
